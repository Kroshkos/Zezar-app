// v1.7: встроенный QR-сканер — отсканированный текст разбирается тем же
// парсером, что и deep link (extractEntityTarget из LinkingContext).
// Тест транслирует модуль в CommonJS и подменяет рантайм-зависимости моками.
const test = require('node:test');
const assert = require('node:assert');

let lc;
try {
  const babel = require('@babel/core');
  const fs = require('node:fs'), path = require('node:path');
  const src = fs.readFileSync(path.join(__dirname, '..', 'src', 'state', 'LinkingContext.js'), 'utf8');
  const out = babel.transformSync(src, {
    babelrc: false, configFile: false, presets: [],
    plugins: [['@babel/plugin-transform-modules-commonjs']], filename: 'LinkingContext.js',
  });
  // мок зависимостей окружения React Native (как в module.test.js через Module._load)
  const Module = require('node:module');
  const reactMock = { createContext: () => ({}), useContext: () => null, useEffect: () => {}, useRef: () => ({ current: null }), useState: () => [null, () => {}] };
  const rnMock = { Linking: { getInitialURL: async () => null, addEventListener() {}, removeEventListener() {} } };
  const notifMock = { addNotificationResponseReceivedListener: () => ({}), removeNotificationSubscription: () => {} };
  const authMock = { useAuth: () => ({ isAuthed: true, token: 'x', guestSession: async () => {} }) };
  const origWrap = Module.wrap;
  Module.wrap = function (code) {
    return origWrap.call(this, [
      'require=(function(o){return function(r){',
      'if(r==="react")return o.react;',
      'if(r==="react-native")return o.rn;',
      'if(r==="expo-notifications")return o.notif;',
      'if(r==="./AuthContext"||r==="../state/AuthContext")return o.auth;',
      'return arguments.callee.origRequire(r);}}(arguments[0]),arguments.callee.origRequire=require);',
      code,
    ].join(''));
  };
  const m = new Module('linking2');
  try {
    m._compile(out.code, path.join(__dirname, 'linking2.compiled.js'));
  } finally { Module.wrap = origWrap; }
  // пробрасываем моки через object-параметр обёртки
  m._compile ? null : null;
  lc = m.exports;
} catch (e) {
  console.error('transpile failed:', e.message);
}

if (!lc) {
  test('QR-парсер недоступен', { skip: true }, () => {});
} else {
  const { extractEntityTarget } = lc;

  test('v1.7: QR zezar://entity/{uid} → uid', () => {
    const t = extractEntityTarget('zezar://entity/abc123');
    assert.ok(t);
    assert.equal(t.uid, 'abc123');
    assert.equal(t.t, undefined);
  });

  test('v1.7: QR https …/open/e/{uid}?t=<гостевой токен> → uid + токен + baseUrl', () => {
    const t = extractEntityTarget('https://open.zezar.app/open/e/uid-9?t=gst.tok.en');
    assert.ok(t);
    assert.equal(t.uid, 'uid-9');
    assert.equal(t.t, 'gst.tok.en');
    assert.equal(t.baseUrl, 'https://open.zezar.app');
  });

  test('v1.7: чужая ссылка / мусор → null (сканер покажет ошибку)', () => {
    assert.equal(extractEntityTarget('https://example.com/other/page'), null);
    assert.equal(extractEntityTarget('привет'), null);
    assert.equal(extractEntityTarget(''), null);
    assert.equal(extractEntityTarget(null), null);
  });
}
