{
  "expo": {
    "name": "ЦЕЗАРЬ",
    "slug": "zezar-app",
    "version": "0.1.0-alpha.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.zezar.mobile",
      "buildNumber": "100"
    },
    "android": {
      "package": "app.zezar.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "versionCode": 101,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "zezar-patfiz.waw0.amvera.tech",
              "pathPrefix": "/open/e/"
            },
            {
              "scheme": "https",
              "host": "open.zezar.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "defaultServerUrl": "https://zezar.example.com",
      "eas": {
        "projectId": "0f79ff51-659e-4b80-bb7e-55b2087ad6a9"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#d97706"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ЦЕЗАРЬ нужен доступ к камере для сканирования QR-кодов карточек"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Приложению нужен доступ к фото для распознавания QR-кодов с карточек"
        }
      ]
    ],
    "scheme": "zezar",
    "owner": "kroshkoss-team"
  }
}
