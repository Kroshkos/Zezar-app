{
  "expo": {
    "name": "ЦЕЗАРЬ",
    "slug": "zezar-app",
    "version": "0.1.0-alpha.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.zezar.mobile",
      "buildNumber": "100"
    },
    "android": {
      "package": "app.zezar.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "versionCode": 100
    },
    "extra": {
      "defaultServerUrl": "https://zezar.example.com"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#d97706"
        }
      ]
    ],
    "scheme": "zezar",
    "owner": "kroshkoss-team"
  }
}